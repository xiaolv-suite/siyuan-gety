{
	"name": "siyuan-gety",
	"version": "0.5.2",
	"description": "小驴思源生态配套 · 索引思源笔记文档并通过本地 HTTP API 全文检索与跳转编辑。XiaoLv Suite companion that indexes SiYuan Note documents via the local kernel HTTP API.",
	"license": "MIT",
	"keywords": [
		"gety",
		"gety-connector",
		"siyuan",
		"siyuan-note",
		"xiaolv"
	],
	"homepage": "https://github.com/xiaolv-suite/siyuan-gety#readme",
	"bugs": "https://github.com/xiaolv-suite/siyuan-gety/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xiaolv-suite/siyuan-gety.git"
	},
	"files": [
		"dist/main.js",
		"dist/main.js.map",
		"icon.svg",
		"icon.png",
		"CHANGELOG.md"
	],
	"scripts": {
		"prepublishOnly": "deno task sync:check"
	},
	"publishConfig": {
		"access": "public"
	},
	"gety": {
		"id": "siyuan-gety",
		"name": "SiYuan Note",
		"version": "0.5.2",
		"min_gety_app_version": "0.7.0",
		"sync_version": 2,
		"permissions": {
			"net": [
				{
					"config_field": "api_url"
				}
			]
		},
		"capabilities": [
			"data-source"
		],
		"entry": "dist/main.js",
		"icon": "icon.svg",
		"description": "小驴思源生态配套 · 索引思源笔记文档并通过本地 HTTP API 全文检索与跳转编辑。XiaoLv Suite companion that indexes SiYuan Note documents via the local kernel HTTP API.",
		"author": {
			"name": "xiaolv-suite",
			"url": "https://github.com/xiaolv-suite"
		},
		"schedule": {
			"strategy": "interval",
			"interval_seconds": 1800
		},
		"doc_link": {
			"kind": "url",
			"field": "url"
		},
		"config": {
			"fields": [
				{
					"id": "api_url",
					"title": "思源 API 地址",
					"type": "text",
					"required": true,
					"default_value": "http://localhost:6806",
					"placeholder": "http://localhost:6806",
					"description": "思源笔记内核 HTTP API 地址。默认端口 6806；若在思源设置中改过端口，请填写实际地址。此地址同时用于本连接器的网络访问授权。"
				},
				{
					"id": "api_token",
					"title": "思源 API 令牌",
					"type": "password",
					"required": true,
					"description": "在思源笔记「设置 → 关于 → API token」中复制。若思源未开启鉴权可留空字符串。"
				}
			]
		},
		"schema": {
			"extra_gety_indexed_fields": [
				{
					"field": "notebook_name",
					"strategy": "fast_text"
				},
				{
					"field": "doc_path",
					"strategy": "fast_text"
				},
				{
					"field": "source_path",
					"strategy": "fast_text"
				},
				{
					"field": "name",
					"strategy": "fast_text"
				},
				{
					"field": "alias",
					"strategy": "fast_text"
				},
				{
					"field": "memo",
					"strategy": "full_text"
				},
				{
					"field": "tags",
					"strategy": "fast_text"
				},
				{
					"field": "links",
					"strategy": "fast_text"
				}
			]
		}
	}
}
